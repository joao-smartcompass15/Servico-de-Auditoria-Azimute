# Copie para .env e preencha. O .env NÃO vai para o git.
#
# Token que a API do gerenciador apresenta para consultar a auditoria
# (Authorization: Bearer <token>). Mínimo de 32 caracteres; o MESMO valor vai
# na variável AUDITORIA_TOKEN_SERVICO da API do gerenciador.
# Para gerar um no PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
AUDITORIA_TOKEN_SERVICO=troque-por-um-token-aleatorio-de-48-caracteres
